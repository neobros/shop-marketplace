# Leave empty in development (Vite proxies /api to http://localhost:5000).
# In production set it to your deployed backend, e.g. https://api.yourshop.com/api
VITE_API_URL=

# Google sign-in (optional): OAuth "Web application" Client ID from Google Cloud Console.
# Must be the same value as GOOGLE_CLIENT_ID in the backend. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

# true  -> customers & artisans can only sign up / sign in with Google (email form hidden;
#          staff/admin use the small "Staff / admin? Sign in with email" link or /login?staff)
# false -> Google button + email/password forms (default)
# Has no effect while VITE_GOOGLE_CLIENT_ID is empty. Restart `npm run dev` after changing.
VITE_GOOGLE_ONLY=false
